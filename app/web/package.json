{
    "name": "@bankan/app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:test": "vite build --mode test",
        "pretest": "npm run build",
        "test": "vitest --run",
        "test:e2e:local": "npx firebase-tools emulators:exec --import test-data \"npm run build:test && npx playwright test --ui --headed\"",
        "test:e2e": "npx firebase-tools emulators:exec --import test-data \"npm run build:test && npx playwright test\"",
        "test:e2e:preview": "npx firebase-tools emulators:exec --import test-data \"npm run build:test && npx vite preview --mode test\""
    },
    "dependencies": {
        "@bankan/domain": "*",
        "@hookform/resolvers": "^5.5.7",
        "@sentry/react": "^10.70.0",
        "firebase": "^12.16.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.83.0",
        "react-hot-toast": "^2.6.0",
        "styled-components": "^6.4.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "dotenv": "^17.4.2",
        "firebase-tools": "^15.26.0",
        "vite": "^8.1.5",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.10"
    }
}
