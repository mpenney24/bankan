{
    "name": "@bankan/app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build:test": "vite build --mode test",
        "test": "vitest --run",
        "test:e2e:local": "pnpm exec firebase emulators:exec --import test-data \"pnpm playwright test --ui --headed\"",
        "test:e2e": "pnpm exec firebase emulators:exec --import test-data \"pnpm playwright test\"",
        "test:e2e:preview": "pnpm exec firebase emulators:exec --import test-data \"pnpm vite preview --mode test\""
    },
    "dependencies": {
        "@bankan/domain": "workspace:*",
        "@hookform/resolvers": "^5.5.7",
        "@sentry/react": "^10.70.0",
        "class-transformer": "^0.4.1",
        "firebase": "^12.16.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.83.0",
        "react-hot-toast": "^2.6.0",
        "reflect-metadata": "^0.2.2",
        "styled-components": "^6.4.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "dotenv": "^17.4.2",
        "firebase-tools": "^15.27.0",
        "vite": "^8.1.5",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.10"
    }
}
