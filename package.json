{
    "name": "bankan-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "app/*",
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm --filter @bankan/app build",
        "test": "pnpm -r test",
        "modules": "rm -rf dist node_modules pnpm-lock.yaml && pnpm i",
        "docker:up": "docker compose build --no-cache && docker compose up",
        "docker:down": "docker compose down",
        "docker:prod": "docker build -f Dockerfile.prod -t bankan-frontend:prod . && docker compose up",
        "format": "prettier --write \".\" && pnpm run lint",
        "lint": "eslint . --fix",
        "dev": "pnpm --filter @bankan/app dev",
        "test:e2e": "pnpm --filter @bankan/app test:e2e",
        "test:e2e:local": "pnpm --filter @bankan/app test:e2e:local",
        "test:e2e:preview": "pnpm --filter @bankan/app test:e2e:preview"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^25.9.5",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "firebase-tools": "^15.26.0",
        "prettier": "^3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.66.0"
    }
}
