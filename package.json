{
    "name": "bankan-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "app/*",
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace=app/web",
        "test": "npm run test --workspaces",
        "modules": "rm -rf dist node_modules package-lock.json && npm i",
        "docker:up": "docker compose build --no-cache && docker compose up",
        "docker:down": "docker compose down",
        "docker:prod": "docker build -f Dockerfile.prod -t bankan-frontend:prod . && docker compose up",
        "format": "prettier --write \".\" && npm run lint",
        "lint": "eslint . --fix",
        "dev": "npm run dev --workspace=app/web",
        "test:e2e": "npm run test:e2e --workspace=app/web",
        "test:e2e:local": "npm run test:e2e:local --workspace=app/web",
        "test:e2e:preview": "npm run test:e2e:preview --workspace=app/web"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "firebase-tools": "^15.26.0",
        "prettier": "^3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.66.0"
    }
}
